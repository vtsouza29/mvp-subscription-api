# Chave exigida por esta API no cabeçalho X-API-Key.
API_KEY=subscription-local-dev-key

# Banco SQLite deste serviço.
DATABASE_URL=sqlite+aiosqlite:///./data/subscription.db

# --- Componente secundária (serviço de metas) ---
# Chave PRÓPRIA do serviço de metas: nunca reaproveite a API_KEY acima.
BUDGET_API_URL=http://localhost:8001
BUDGET_API_KEY=budget-local-dev-key
BUDGET_API_TIMEOUT_SECONDS=3.0
BUDGET_API_RETRIES=1

# --- API externa de câmbio (pública, sem cadastro e sem chave) ---
FRANKFURTER_URL=https://api.frankfurter.dev/v1
FRANKFURTER_TIMEOUT_SECONDS=5.0
FX_CACHE_TTL_SECONDS=900
FX_FALLBACK_TTL_SECONDS=604800

# Cache compartilhado. Se ausente ou inacessível, cai para cache em memória.
# REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=900

# Popula assinaturas sintéticas no start. Mantenha false fora da demonstração.
SEED_ON_STARTUP=false

# Dias sem uso a partir dos quais uma assinatura entra no relatório de desperdício.
IDLE_DAYS_THRESHOLD=30

LOG_LEVEL=INFO
